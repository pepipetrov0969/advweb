# Имейл известия от формите (запазване на час + контактна форма).
# Използва се Resend (https://resend.com) - безплатен план е достатъчен.
# Без зададен ключ формите работят, но съобщенията само се логват в конзолата.

RESEND_API_KEY=
BOOKING_TO_EMAIL=atanasovva@abv.bg
BOOKING_FROM_EMAIL=website@advatanasova.bg

# Съхранение на заетите часове (запазване на час) - Upstash Redis / Vercel KV.
# ЗАДЪЛЖИТЕЛНО на Vercel (и всеки друг хостинг с read-only файлова система) -
# без тях заявката за запазване на час гърми с грешка и имейл НЕ се изпраща.
# Настройка: Vercel -> проекта -> Storage -> Create Database -> Upstash Redis,
# после Vercel попълва тези две променливи автоматично (Settings -> Environment
# Variables), или ги вземете директно от upstash.com.
# Локално (без тях): часовете се пазят във файл .data/bookings.json - ОК само
# за localhost.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
